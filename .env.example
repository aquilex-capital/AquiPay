# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://aquipay:aquipay@localhost:54329/aquipay
PORT=8080
# Public origin of the checkout page.
PUBLIC_BASE_URL=http://localhost:8080
# Bearer token your backend uses to call /v1/*.
API_KEY=change-me
# Where topup.confirmed events are POSTed, and the HMAC secret that signs them.
WEBHOOK_URL=http://localhost:3000/webhooks/aquipay
WEBHOOK_SECRET=change-me-too

# --- Chains -----------------------------------------------------------------
# Any of: ethereum, arbitrum, optimism, polygon, bsc, local
CHAINS=local
# ForwarderFactory address (identical on every chain).
# FORWARDER_FACTORY_ADDRESS=0x...
# Comma-separated RPC endpoints per chain; later ones are fallbacks.
RPC_URLS_LOCAL=http://localhost:8545
# RPC_URLS_ARBITRUM=https://...,https://...
# Only the local chain needs its USDT address set; real chains are pinned in code.
# USDT_ADDRESS_LOCAL=0x...

# Optional per-chain overrides (suffix is the chain name in upper case):
# MIN_TOPUP_ETHEREUM=20
# CONFIRMATIONS_POLYGON=64
# MAX_GAS_PRICE_GWEI_ETHEREUM=5
# MIN_BLOCK_MS_ARBITRUM=100
# These also take a chain-wide form without the suffix; the suffixed one wins.
# The defaults fit a free RPC plan (Alchemy's caps eth_getLogs at 10 blocks).
# POLL_SECONDS=5
# LOG_RANGE=10
# HISTORICAL_READS=true
# Multicall3 is at its usual address on every real chain; dev-setup puts one
# there on anvil too.
# MULTICALL3_ADDRESS_LOCAL=0xcA11bde05977b3631167028862bE2a173976CA11
# MULTICALL_BATCH=500

# --- Invoices ---------------------------------------------------------------
# How long an address is live, and how long after that a late payment is still
# looked for (on a pass every LATE_PASS_SECONDS) and credited.
# INVOICE_TTL_SECONDS=600
# LATE_PAYMENT_HOURS=24
# LATE_PASS_SECONDS=3600

# --- Sweeper ----------------------------------------------------------------
# Pays gas for sweeps. Fund it with a little native token on each chain.
# Below is anvil's public development key #2; never use it on a real chain.
SWEEPER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
SWEEP_INTERVAL_SECONDS=3600
SWEEP_BATCH_SIZE=50
