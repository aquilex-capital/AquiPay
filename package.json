{
  "name": "aquipay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=.env src/main.ts all",
    "migrate": "node --env-file=.env src/main.ts migrate",
    "test": "vitest run",
    "contracts:build": "docker run --rm -v \"$PWD\":/repo -w /repo/contracts --entrypoint forge ghcr.io/foundry-rs/foundry:stable build",
    "contracts:test": "docker run --rm -v \"$PWD\":/repo -w /repo/contracts --entrypoint forge ghcr.io/foundry-rs/foundry:stable test -vv"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "viem": "^2.58.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
